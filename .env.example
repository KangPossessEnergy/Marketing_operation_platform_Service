DATABASE_URL="postgresql://nest:nest@localhost:5432/nest_learn?schema=public"
# Comma-separated frontend origins. When omitted, CORS is open only outside production.
CORS_ORIGIN="http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173"
HOST="0.0.0.0"
JWT_SECRET="replace-with-a-long-random-secret"
ACCESS_TOKEN_EXPIRES_IN="3600"
AUTH_USERNAME="admin"
AUTH_PASSWORD="123456"
SMS_PROVIDER="mock"
SMS_CODE_SECRET="replace-with-a-different-random-secret"
SMS_CODE_EXPIRES_IN="300"
SMS_CODE_RESEND_INTERVAL="60"
SMS_CODE_MAX_ATTEMPTS="5"
# Only for local/test mock SMS. Never configure this in production.
SMS_FIXED_CODE="123456"
